{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(alembic upgrade:*)",
      "Bash(docker compose up:*)",
      "Bash(git push:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Bash(alembic downgrade:*)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(**/.env.*.local)",
      "Read(**/.env.staging)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)"
    ]
  }
}
