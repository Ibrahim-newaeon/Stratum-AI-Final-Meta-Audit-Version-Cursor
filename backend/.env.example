# =============================================================================
# Stratum AI - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control
#
# SECURITY REQUIREMENTS FOR PRODUCTION:
# =====================================
# 1. Set APP_ENV=production
# 2. Generate secure keys using:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Use strong database password (20+ chars, mixed case, numbers, symbols)
# 4. Never use default/example values in production
#
# The application will REFUSE to start in production mode with weak credentials.
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Stratum AI
APP_ENV=development
DEBUG=true

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_SECURE_KEY_MIN_32_CHARS
JWT_SECRET_KEY=GENERATE_SECURE_KEY_MIN_32_CHARS
PII_ENCRYPTION_KEY=GENERATE_SECURE_KEY_MIN_32_CHARS

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL with async support
# IMPORTANT: Replace 'YOUR_STRONG_PASSWORD' with a secure password
DATABASE_URL=postgresql+asyncpg://stratum:YOUR_STRONG_PASSWORD@localhost:5432/stratum_ai
DATABASE_URL_SYNC=postgresql://stratum:YOUR_STRONG_PASSWORD@localhost:5432/stratum_ai

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# =============================================================================
# Redis & Celery Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Ad Platform Credentials
# =============================================================================
# Mock mode writes GENERATED campaign metrics into the database. Off by
# default, rejected when APP_ENV=production; true here for local dev and
# the demo seed only.
USE_MOCK_AD_DATA=true

# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Stratum's own marketing pixel. Sends landing-page waitlist leads (which have
# no tenant) back to the Meta Conversions API. Leave blank to disable.
META_PIXEL_ID=

# Public origin of THIS API. Builds the Meta OAuth redirect_uri and the status
# URL the Meta Data Deletion callback returns to Meta, so a loopback value there
# gives Meta a dead link. Origin only - no path, no trailing slash.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Autopilot execution (Meta Marketing API WRITES) - OFF BY DEFAULT
# -----------------------------------------------------------------------------
# The only path that can change a live ad account. It requires the
# ads_management permission (ads_read cannot write), which is subject to Meta
# App Review, and it takes TWO deliberate flags to enable so that deploying
# this feature cannot start spending money on its own:
#
#   AUTOPILOT_EXECUTION_ENABLED=true   master switch (default false)
#   AUTOPILOT_EXECUTION_DRY_RUN=false  default true: every gate, enforcement
#                                      and guard-rail check runs and the
#                                      intended change is recorded, but no
#                                      write endpoint is called
#
# The Celery task (tasks.apply_actions_queue) is additionally NOT scheduled;
# see docs/architecture/trust-engine.md before wiring it into beat.
AUTOPILOT_EXECUTION_ENABLED=false
AUTOPILOT_EXECUTION_DRY_RUN=true
META_WRITE_REQUEST_TIMEOUT_SECONDS=30

# Guard rails. Every one is enforced BEFORE the write and a violation is a
# refusal with a recorded reason, never a clamp-and-proceed.
AUTOPILOT_MAX_BUDGET_CHANGE_PCT=20
AUTOPILOT_MAX_CUMULATIVE_BUDGET_CHANGE_PCT=50
AUTOPILOT_MAX_EXECUTED_ACTIONS_PER_TENANT_PER_DAY=10

# The daily budget floor and ceiling are absolute amounts in the ad account's
# MAJOR currency unit. These two defaults are sized for the currencies Meta
# gives an offset of 100 (USD, EUR, GBP, ...). For a currency Meta gives an
# offset of 1 - JPY, KRW, VND, IDR, CLP, COP, CRC, HUF, ISK, PYG, TWD - an
# ordinary daily budget is a five-figure number of major units, so these values
# are meaningless there: the ceiling would refuse every action and the floor
# would never bind. Such an account must have an explicit pair below, and
# budget actions on it are refused until it does. Raising the two globals
# instead would raise them for every dollar account on the deployment too.
AUTOPILOT_MIN_DAILY_BUDGET_MAJOR=5
AUTOPILOT_MAX_DAILY_BUDGET_MAJOR=1000
# CURRENCY:floor:ceiling triples, comma separated. Example:
#   AUTOPILOT_DAILY_BUDGET_LIMITS_BY_CURRENCY=JPY:750:150000,KRW:7000:1500000
AUTOPILOT_DAILY_BUDGET_LIMITS_BY_CURRENCY=

# Allowlist of action types that may ever execute automatically. Starts from
# app.autopilot.service.SAFE_ACTIONS - the reversible, spend-reducing actions.
# budget_increase, pause_campaign and every enable_* are deliberately absent:
# raising spend or restarting delivery is not something automation should do
# unsupervised. pause_creative is withheld for a different reason - the Meta
# node it targets is not established (the producer emits a creative id, and the
# executor maps "creative" to the ad), so it is opt-in until that is pinned
# down. See docs/architecture/trust-engine.md.
AUTOPILOT_EXECUTABLE_ACTION_TYPES=budget_decrease,pause_adset,bid_decrease

# =============================================================================
# WhatsApp Business API Configuration
# =============================================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=stratum-whatsapp-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v18.0

# =============================================================================
# CRM Integrations
# =============================================================================
# CRM OAuth apps. One app per provider, shared by every tenant; the per-tenant
# tokens, account ids and provider metadata (Salesforce instance_url, Pipedrive
# api_domain) live in the database on crm_connections, never here. Leave a pair
# blank to keep that provider's connect flow disabled.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho data center for this app: com, eu, in, com.au, jp or com.cn
ZOHO_REGION=com

# =============================================================================
# Measurement & Verification (read-only, NOT an ad platform)
# =============================================================================
# Google Analytics 4 = independent, read-only revenue/conversion baseline
# (GA4 Data API, scope https://www.googleapis.com/auth/analytics.readonly).
# Google Tag Manager = tag deployment only (web container + server-side tagging
# for Meta Pixel/CAPI and the Stratum snippet).
# These are the ONLY global GA4_*/GTM_* toggles. GA4 property IDs,
# service-account keys and GTM container IDs are per tenant and are configured
# in the app under Settings > Integrations > Measurement & Verification
# (never as environment variables).
GA4_SYNC_ENABLED=true
GA4_LOOKBACK_DAYS=3
GA4_BACKFILL_DAYS=30
GA4_REQUEST_TIMEOUT_SECONDS=30
GA4_DEFAULT_CONVERSION_EVENT=purchase
GTM_VERIFY_TIMEOUT_SECONDS=10
GTM_DEFAULT_SERVER_CONTAINER_URL=

# =============================================================================
# Market Intelligence Configuration
# =============================================================================
# Provider: mock, serpapi, dataforseo
MARKET_INTEL_PROVIDER=mock

# SerpApi (for search engine results)
SERPAPI_KEY=

# DataForSEO (for competitor intelligence)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# =============================================================================
# ML Configuration
# =============================================================================
# Provider: local (scikit-learn models loaded from ML_MODELS_PATH)
ML_PROVIDER=local
ML_MODELS_PATH=/app/ml_service/models

# =============================================================================
# Security Configuration
# =============================================================================
# PII encryption key (32 characters, used for encrypting sensitive data)
PII_ENCRYPTION_KEY=your-32-character-encryption-key

# JWT Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Logging & Monitoring
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: json or console
LOG_FORMAT=console

# Sentry (error tracking)
SENTRY_DSN=

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
# Use any SMTP relay (your mail provider or a transactional email service).
# Most providers require an app-specific password or API key rather than the account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@stratumai.app
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_TLS=true
EMAIL_FROM_NAME=Stratum AI
EMAIL_FROM_ADDRESS=info@stratumai.app

# =============================================================================
# Paddle Billing Configuration (optional)
# =============================================================================
# Stratum uses Paddle Billing (Merchant of Record) for subscriptions, payments
# and invoices. Leave PADDLE_API_KEY empty to run without billing.
#
# PADDLE_ENVIRONMENT: 'sandbox' (https://sandbox-api.paddle.com, sandbox
# dashboard) for development and staging, 'production' (https://api.paddle.com)
# for live billing. With APP_ENV=production the app refuses to start when an
# API key is set but the environment is still 'sandbox' or a companion value
# below is missing.
PADDLE_ENVIRONMENT=sandbox

# Server-side API key (Paddle dashboard > Developer Tools > Authentication > API keys)
PADDLE_API_KEY=

# Client-side token for the Paddle.js overlay checkout
# (Developer Tools > Authentication > Client-side tokens). Served to the SPA by
# GET /api/v1/billing/config; never put it in frontend env files.
PADDLE_CLIENT_TOKEN=

# Notification destination secret key (Developer Tools > Notifications), used to
# verify the Paddle-Signature header on POST /api/v1/webhooks/paddle
# (HMAC-SHA256 over "<ts>:<raw body>", 5-minute timestamp tolerance).
PADDLE_WEBHOOK_SECRET=

# Recurring price ids for each tier (Catalog > Products > Prices; ids start with pri_)
# Trials are configured on the Paddle price itself.
PADDLE_STARTER_PRICE_ID=pri_starter_monthly_placeholder
PADDLE_PROFESSIONAL_PRICE_ID=pri_professional_monthly_placeholder
PADDLE_ENTERPRISE_PRICE_ID=pri_enterprise_monthly_placeholder

# =============================================================================
# CDN Cache Invalidation (optional)
# =============================================================================
# Provider: cloudflare, cloudfront, fastly (leave empty to disable)
CDN_PROVIDER=
# API token (Cloudflare Bearer token or Fastly API token; not needed for CloudFront)
CDN_API_KEY=
# Zone/Distribution ID (Cloudflare Zone ID or CloudFront Distribution ID)
CDN_ZONE_ID=
# Public base URL for constructing full purge URLs (e.g. https://blog.stratum.ai)
CDN_BASE_URL=

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_ML_FEATURES=true
ENABLE_COMPETITOR_INTEL=true
ENABLE_WHATSAPP=true
