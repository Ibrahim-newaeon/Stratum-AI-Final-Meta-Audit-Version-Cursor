# =============================================================================
# Stratum AI Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# API Configuration
# Leave unset to use same-origin /api (proxied by Vite in dev and nginx in production)
# VITE_API_URL=/api/v1
# VITE_API_BASE_URL=

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8000

# Localization
VITE_DEFAULT_LOCALE=en

# =============================================================================
# Monitoring & Error Tracking
# =============================================================================

# Sentry DSN (get from https://sentry.io)
# Leave empty to disable Sentry
VITE_SENTRY_DSN=

# Enable Sentry debug mode in development (sends errors to Sentry even in dev)
VITE_SENTRY_DEBUG=false

# =============================================================================
# Billing
# =============================================================================

# Paddle Billing (optional override; environment normally comes from the API)
# The Paddle client-side token is never set here - it is served by GET /api/v1/billing/config
VITE_PADDLE_ENVIRONMENT=

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable experimental features
VITE_ENABLE_EXPERIMENTS=false
