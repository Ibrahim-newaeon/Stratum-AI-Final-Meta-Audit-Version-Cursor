# =============================================================================
# Stratum AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
#
# SECURITY REQUIREMENTS FOR PRODUCTION:
# =====================================
# 1. Set APP_ENV=production
# 2. Generate secure keys using:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Use strong database password (20+ chars, mixed case, numbers, symbols)
# 4. Never use default/example values in production
#
# The application will REFUSE to start in production mode with weak credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=StratumAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Subscription Tier (starter | professional | enterprise)
# -----------------------------------------------------------------------------
SUBSCRIPTION_TIER=enterprise

# REQUIRED: Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_SECURE_KEY_MIN_32_CHARS
JWT_SECRET_KEY=GENERATE_SECURE_KEY_MIN_32_CHARS
PII_ENCRYPTION_KEY=GENERATE_SECURE_KEY_MIN_32_CHARS

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16+)
# -----------------------------------------------------------------------------
POSTGRES_USER=stratum
# IMPORTANT: Generate a strong password for production!
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_DB=stratum_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# -----------------------------------------------------------------------------
# ML Provider Configuration (Module A: Intelligence Engine)
# -----------------------------------------------------------------------------
# Provider: 'local' (scikit-learn models loaded from ML_MODELS_PATH)
ML_PROVIDER=local
ML_MODELS_PATH=/app/ml_service/models

# -----------------------------------------------------------------------------
# Ad Platform API Keys (Mock mode by default)
# -----------------------------------------------------------------------------
# Mock mode writes GENERATED campaign metrics into the database instead of
# calling a platform API. It is off by default and rejected outright when
# APP_ENV=production; keep it true only on a local box or a demo tenant.
# With it false the sync tasks pull real, READ-ONLY Meta Marketing API
# insights (below); a tenant without a usable Meta credential gets no rows
# and no claim of success, so no fabricated row is ever written.
USE_MOCK_AD_DATA=true

# Meta/Facebook Ads
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Stratum's own marketing pixel. Sends landing-page waitlist leads (which have
# no tenant) back to the Meta Conversions API. Leave blank to disable.
META_PIXEL_ID=

# -----------------------------------------------------------------------------
# "Log in with Facebook" (sign-in only - NOT an ad-account connection)
# -----------------------------------------------------------------------------
# Lets a person sign in to Stratum with their Facebook account. It reuses
# META_APP_ID / META_APP_SECRET above and asks only for public_profile and
# email; it reads GET /debug_token and GET /me and issues no other Meta call,
# so it grants no ads_read and no ads_management. Off by default.
#
# Before turning this on, in the Meta App Dashboard:
#   * Facebook Login > Settings > "Allowed Domains for the JavaScript SDK"
#     must list the exact origin the SPA is served from. When that list is
#     non-empty and your origin is missing, FB.login() refuses to run and the
#     button fails with no server-side error to look at.
#   * App Review must grant ADVANCED access to "email". With Standard access
#     the app is live but only people with a role on the app get an email
#     back, so everyone else provisions an account with no address.
FACEBOOK_LOGIN_ENABLED=false
# Permissions the login dialog requests. public_profile is always granted;
# email can be declined, and the backend never assumes it came back.
FACEBOOK_LOGIN_SCOPES=public_profile,email
# Facebook Login for Business only: the saved configuration id passed to
# FB.login() as config_id. It must be a *User access token* configuration whose
# permissions are public_profile/email - that is the only kind that identifies a
# person. A System User configuration (WhatsApp Embedded Signup, Conversions API
# onboarding, any "share business assets" flow) opens a business-onboarding
# dialog instead of a consent dialog, and the token it returns is refused by
# login_client as not_a_user_token. Leave blank for the consumer login dialog,
# which uses the scope list above directly.
FACEBOOK_LOGIN_CONFIG_ID=
# True only when that configuration requires the authorization code grant, which
# System User configurations do and User access token configurations do not.
# Sending the wrong one fails the dialog before it renders.
FACEBOOK_LOGIN_USE_CODE_FLOW=false
# Allow a Facebook identity nobody has seen before to provision a new tenant
# and admin user, mirroring POST /auth/signup. False limits Facebook to signing
# in accounts that already linked it.
FACEBOOK_LOGIN_ALLOW_SIGNUP=true
# Account-takeover boundary. Meta returns an email it considers confirmed, but
# "same email address" is not proof of "same person": with this true, anyone
# able to put an address on a Facebook profile could claim the Stratum account
# holding it, skipping both the password and MFA. Leave it false - an existing
# account is claimed by signing in with its password and connecting Facebook
# from account settings.
FACEBOOK_LOGIN_AUTO_LINK_BY_EMAIL=false

# Public origin of THIS API, used to build the Meta OAuth redirect_uri and the
# status URL the Meta Data Deletion callback hands back to Meta. Set it in every
# deployed environment: the default below is loopback, which is useless to Meta
# and to the person following the link. Origin only - no path, no trailing slash.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Meta insights ingestion (READ-ONLY, GET only, scope ads_read).
# The campaign sync calls GET /act_<id>/insights at campaign level with
# time_increment=1 and writes CampaignMetric rows. Per-tenant access tokens
# and ad accounts live in the database (tenant_platform_connection /
# tenant_ad_account), never here - these are global knobs only.
# The lookback window is re-pulled and upserted on every run because Meta
# restates conversions for days after the fact.
#
# META_GRAPH_API_VERSION is the ONE Graph version for every Meta caller: the
# insights client, the Conversions API and WhatsApp connectors, offline
# conversions, CDP audience sync and the OAuth flow. v23.0 is supported until
# 2027-10-08; v26.0 is the current stable release.
#
# META_CONVERSION_ACTION_TYPES: the first configured type present in a row
# wins, so order matters. Keep a type your ad accounts actually report -
# offsite_conversion.fb_pixel_purchase is web-pixel only, and omni_purchase is
# Meta's documented grouped type covering app, on-Facebook and offline
# purchases. An account whose purchases match none of these records
# conversions and revenue as zero.
META_GRAPH_API_VERSION=v23.0
META_INSIGHTS_LOOKBACK_DAYS=7
META_INSIGHTS_REQUEST_TIMEOUT_SECONDS=30
META_INSIGHTS_MAX_PAGES=25
META_CONVERSION_ACTION_TYPES=offsite_conversion.fb_pixel_purchase,omni_purchase,purchase

# -----------------------------------------------------------------------------
# Autopilot execution (Meta Marketing API WRITES) - OFF BY DEFAULT
# -----------------------------------------------------------------------------
# The only path that can change a live ad account. It requires the
# ads_management permission (ads_read cannot write), which is subject to Meta
# App Review, and it takes TWO deliberate flags to enable so that deploying
# this feature cannot start spending money on its own:
#
#   AUTOPILOT_EXECUTION_ENABLED=true   master switch (default false)
#   AUTOPILOT_EXECUTION_DRY_RUN=false  default true: every gate, enforcement
#                                      and guard-rail check runs and the
#                                      intended change is recorded, but no
#                                      write endpoint is called
#
# The Celery task (tasks.apply_actions_queue) is additionally NOT scheduled;
# see docs/architecture/trust-engine.md before wiring it into beat.
AUTOPILOT_EXECUTION_ENABLED=false
AUTOPILOT_EXECUTION_DRY_RUN=true
META_WRITE_REQUEST_TIMEOUT_SECONDS=30

# Guard rails. Every one is enforced BEFORE the write and a violation is a
# refusal with a recorded reason, never a clamp-and-proceed.
AUTOPILOT_MAX_BUDGET_CHANGE_PCT=20
AUTOPILOT_MAX_CUMULATIVE_BUDGET_CHANGE_PCT=50
AUTOPILOT_MAX_EXECUTED_ACTIONS_PER_TENANT_PER_DAY=10

# The daily budget floor and ceiling are absolute amounts in the ad account's
# MAJOR currency unit. These two defaults are sized for the currencies Meta
# gives an offset of 100 (USD, EUR, GBP, ...). For a currency Meta gives an
# offset of 1 - JPY, KRW, VND, IDR, CLP, COP, CRC, HUF, ISK, PYG, TWD - an
# ordinary daily budget is a five-figure number of major units, so these values
# are meaningless there: the ceiling would refuse every action and the floor
# would never bind. Such an account must have an explicit pair below, and
# budget actions on it are refused until it does. Raising the two globals
# instead would raise them for every dollar account on the deployment too.
AUTOPILOT_MIN_DAILY_BUDGET_MAJOR=5
AUTOPILOT_MAX_DAILY_BUDGET_MAJOR=1000
# CURRENCY:floor:ceiling triples, comma separated. Example:
#   AUTOPILOT_DAILY_BUDGET_LIMITS_BY_CURRENCY=JPY:750:150000,KRW:7000:1500000
AUTOPILOT_DAILY_BUDGET_LIMITS_BY_CURRENCY=

# Allowlist of action types that may ever execute automatically. Starts from
# app.autopilot.service.SAFE_ACTIONS - the reversible, spend-reducing actions.
# budget_increase, pause_campaign and every enable_* are deliberately absent:
# raising spend or restarting delivery is not something automation should do
# unsupervised. pause_creative is withheld for a different reason - the Meta
# node it targets is not established (the producer emits a creative id, and the
# executor maps "creative" to the ad), so it is opt-in until that is pinned
# down. See docs/architecture/trust-engine.md.
AUTOPILOT_EXECUTABLE_ACTION_TYPES=budget_decrease,pause_adset,bid_decrease

# -----------------------------------------------------------------------------
# CRM Integrations
# -----------------------------------------------------------------------------
# CRM OAuth apps. One app per provider, shared by every tenant; the per-tenant
# tokens, account ids and provider metadata (Salesforce instance_url, Pipedrive
# api_domain) live in the database on crm_connections, never here. Leave a pair
# blank to keep that provider's connect flow disabled.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Zoho data center for this app: com, eu, in, com.au, jp or com.cn
ZOHO_REGION=com

# -----------------------------------------------------------------------------
# Measurement & Verification (read-only, NOT an ad platform)
# -----------------------------------------------------------------------------
# Google Analytics 4 = independent, read-only revenue/conversion baseline
# (GA4 Data API, scope https://www.googleapis.com/auth/analytics.readonly).
# Google Tag Manager = tag deployment only (web container + server-side tagging
# for Meta Pixel/CAPI and the Stratum snippet).
# These are the ONLY global GA4_*/GTM_* toggles. GA4 property IDs,
# service-account keys and GTM container IDs are per tenant and are configured
# in the app under Settings > Integrations > Measurement & Verification
# (never as environment variables).
GA4_SYNC_ENABLED=true
GA4_LOOKBACK_DAYS=3
GA4_BACKFILL_DAYS=30
GA4_REQUEST_TIMEOUT_SECONDS=30
GA4_DEFAULT_CONVERSION_EVENT=purchase
GTM_VERIFY_TIMEOUT_SECONDS=10
GTM_DEFAULT_SERVER_CONTAINER_URL=

# -----------------------------------------------------------------------------
# Market Intelligence (Module D)
# -----------------------------------------------------------------------------
# Options: 'mock', 'serpapi', 'dataforseo'
MARKET_INTEL_PROVIDER=mock

# SerpApi (optional)
SERPAPI_KEY=

# DataForSEO (optional)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# -----------------------------------------------------------------------------
# Security & Encryption
# -----------------------------------------------------------------------------
# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption Key for PII (32-byte base64-encoded)
PII_ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# Paddle Billing (optional; Merchant of Record for subscriptions & invoices)
# -----------------------------------------------------------------------------
# Leave PADDLE_API_KEY empty to run without billing.
# 'sandbox' (https://sandbox-api.paddle.com) for development/staging,
# 'production' (https://api.paddle.com) for live billing. In APP_ENV=production
# the app refuses to start when an API key is set but the environment is still
# 'sandbox' or a companion value below is missing.
PADDLE_ENVIRONMENT=sandbox
# Developer Tools > Authentication > API keys
PADDLE_API_KEY=
# Developer Tools > Authentication > Client-side tokens (used by Paddle.js checkout,
# served to the SPA via GET /api/v1/billing/config)
PADDLE_CLIENT_TOKEN=
# Developer Tools > Notifications > destination secret key (verifies Paddle-Signature
# on POST /api/v1/webhooks/paddle)
PADDLE_WEBHOOK_SECRET=
# Catalog > Products > recurring price ids (pri_...); trials are set on the price
PADDLE_STARTER_PRICE_ID=pri_starter_monthly_placeholder
PADDLE_PROFESSIONAL_PRICE_ID=pri_professional_monthly_placeholder
PADDLE_ENTERPRISE_PRICE_ID=pri_enterprise_monthly_placeholder

# -----------------------------------------------------------------------------
# Observability & Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# CDN Cache Invalidation (optional)
# -----------------------------------------------------------------------------
# Provider: cloudflare, cloudfront, fastly (leave empty to disable)
CDN_PROVIDER=
# API token (Cloudflare Bearer token or Fastly API token; not needed for CloudFront)
CDN_API_KEY=
# Zone/Distribution ID (Cloudflare Zone ID or CloudFront Distribution ID)
CDN_ZONE_ID=
# Public base URL for constructing full purge URLs (e.g. https://blog.stratum.ai)
CDN_BASE_URL=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_COMPETITOR_INTEL=true
FEATURE_WHAT_IF_SIMULATOR=true
FEATURE_AUTOMATION_RULES=true
FEATURE_GDPR_COMPLIANCE=true
